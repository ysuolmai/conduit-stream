# ESP32-S3 N4R2 + PCM5102A target.
CONFIG_IDF_TARGET="esp32s3"

# 4 MB DIO flash at 80 MHz, 2 MB quad PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_MODE_OCT=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-n4r2.csv"

# Keep the RTP reorder window compact for the 2 MB PSRAM target. The PCM ring
# remains two seconds because bulk copies make it cheap and it absorbs bursts.
CONFIG_CONDUIT_SMALL_MEMORY=y

# I2S: ESP32 GPIO11 -> PCM5102A DIN, GPIO12 -> BCK, GPIO13 -> LRCK.
CONFIG_CONDUIT_I2S_DOUT_GPIO=11
CONFIG_CONDUIT_I2S_BCLK_GPIO=12
CONFIG_CONDUIT_I2S_LRCK_GPIO=13

# PCM5102A is stereo line-out; do not mix the AirPlay channels to mono.
CONFIG_CONDUIT_MONO_OUTPUT=n

# Use the native USB Serial/JTAG console on S3 boards with USB-C.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
